{
  "name": "tiny-pdf-editor",
  "version": "1.2.0",
  "private": true,
  "description": "Tiny PDF Editor Neo (Electron + Python engine)",
  "scripts": {
    "neo:install": "npm --prefix neo-app install",
    "neo": "npm --prefix neo-app run dev",
    "neo:restart": "npm --prefix neo-app run dev:restart",
    "neo:stop": "npm --prefix neo-app run dev:stop",
    "build:engine": "npm --prefix neo-app run build:engine",
    "build:release": "npm --prefix neo-app run build:release"
  }
}
