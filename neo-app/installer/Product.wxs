<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-user MSI (no admin rights needed) for the Electron app.
  Built by scripts/build-release.mjs with:
    -d AppName=… -d AppId=… -d ExeName=… -d ProductVersion=x.y.z.n -d ProductCode={guid}
    -d StageDir=<absolute path of the unpacked app> -d InstallerDir=<this folder>

  Mutable state (settings, members, backups) lives in %APPDATA% — never inside
  the install folder — so upgrades and uninstalls cannot wipe it.

  IDENTITY: UpgradeCode and the component GUIDs below belong to Tiny PDF Editor NEO only.
  They must never equal another product's (the Default Framework template uses different
  ones): a shared UpgradeCode makes one MSI replace the other. `npm run check:identity`
  enforces this and runs at the start of every release build.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="$(AppName)"
    Manufacturer="$(AppName)"
    Version="$(ProductVersion)"
    ProductCode="$(ProductCode)"
    UpgradeCode="DD3EA488-DB69-410F-8BD0-B40B5C274874"
    Scope="perUser"
    Compressed="yes">

    <SummaryInformation Description="$(AppName)" />

    <!--
      A new ProductCode + AllowSameVersionUpgrades lets every build replace the previous one.

      Schedule="afterInstallValidate": the old product is removed completely BEFORE the new files
      are costed, so every file is laid down fresh. With afterInstallInitialize the installer decided
      per file against the old install (same file version = keep), so an exe whose version did not
      change stayed behind next to the new Electron DLLs/snapshot (V8 version mismatch, app exits
      right after launch). Shortcut pins survive because RemoveShortcuts below skips upgrades.
    -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallValidate"
      DowngradeErrorMessage="A newer version of $(AppName) is already installed." />

    <!--
      Legacy Tiny PDF Editor (PyQt, folder "Tiny PDF Editor - Legacy") uses a different
      UpgradeCode on purpose. Detect it and let RemoveExistingProducts uninstall that MSI
      before Neo is laid down. Do NOT reuse Legacy's UpgradeCode as this package's
      UpgradeCode — that would make Neo and Legacy replace each other as the same product.
      Portable / manually copied Legacy installs are not MSI products and are not removed.
    -->
    <Upgrade Id="A3C7E1F4-9B2D-4E6A-8C0F-1D5E7B9A2C4E">
      <UpgradeVersion
        Minimum="0.0.0.0"
        Maximum="255.0.0.0"
        Property="LEGACY_TINY_PDF"
        IncludeMinimum="yes"
        IncludeMaximum="yes" />
    </Upgrade>

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(StageDir)\app-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!--
      The print watcher (print-watch.mjs, ELECTRON_RUN_AS_NODE) deliberately outlives the app so
      printing keeps working while the app is closed. It runs from this exe, so an upgrade or
      uninstall must stop it (and the app) first, otherwise the files are "in use".
      CloseMessage asks the app nicely first; TerminateProcess ends whatever is left (the
      windowless watcher has no window to ask).
    -->
    <util:CloseApplication
      Id="CloseApp"
      Target="$(ExeName)"
      CloseMessage="yes"
      RebootPrompt="no"
      TerminateProcess="0" />

    <!--
      Legacy MSI runs Tiny PDF Editor.exe (app + print helper). Close it before
      RemoveExistingProducts deletes Legacy, otherwise files stay locked.
    -->
    <util:CloseApplication
      Id="CloseLegacyTinyPdfEditor"
      Target="Tiny PDF Editor.exe"
      Description="Tiny PDF Editor (Legacy)"
      CloseMessage="yes"
      EndSessionMessage="yes"
      RebootPrompt="no"
      PromptToContinue="no"
      TerminateProcess="2000"
      Timeout="5000" />

    <!--
      After install/upgrade restart the watcher right away, so printing works before the next
      login. It exits by itself when the virtual printer is not installed (fresh install: the
      app installs the printer on first launch).
    -->
    <CustomAction
      Id="LaunchPrintWatch"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]$(ExeName)&quot; --print-watch"
      Return="asyncNoWait" />

    <!-- Keep pinned taskbar shortcuts across MSI upgrades (still remove on uninstall). -->
    <InstallExecuteSequence>
      <RemoveShortcuts Condition="Installed AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchPrintWatch" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(InstallerDir)\License.rtf" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="$(AppName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(AppName)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="ProductFeature" Title="$(AppName)" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(StageDir)\**" />

      <Component
        Id="StartMenuShortcut"
        Directory="ApplicationProgramsFolder"
        Guid="1F6B34EF-B85C-49F9-B6A3-09889AED87FC">
        <Shortcut
          Id="StartMenuShortcutLink"
          Name="$(AppName)"
          Description="$(AppName)"
          Target="[INSTALLFOLDER]$(ExeName)"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon.ico">
          <!-- Same AUMID as app.setAppUserModelId — required for taskbar pin icon after reboot. -->
          <ShortcutProperty Key="System.AppUserModel.ID" Value="$(AppId)" />
        </Shortcut>
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\$(AppName)"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>

      <Component
        Id="DesktopShortcut"
        Directory="DesktopFolder"
        Guid="202E7B2C-41C4-4FEA-A7E2-EF926D4F7646">
        <Shortcut
          Id="DesktopShortcutLink"
          Name="$(AppName)"
          Description="$(AppName)"
          Target="[INSTALLFOLDER]$(ExeName)"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon.ico">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="$(AppId)" />
        </Shortcut>
        <RegistryValue
          Root="HKCU"
          Key="Software\$(AppName)"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
