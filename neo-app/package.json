{
  "name": "tiny-pdf-editor-neo-app",
  "productName": "Tiny PDF Editor - NEO",
  "version": "1.0.0",
  "description": "Tiny PDF Editor NEO: Electron + React UI over a bundled Python PDF engine, with a virtual PDF printer.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:icons && electron .",
    "dev:stop": "node scripts/dev-process.mjs stop",
    "dev:restart": "node scripts/dev-process.mjs restart",
    "dev:re": "npm run dev:restart",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "build": "npm run prepare:icons && vite build",
    "check:identity": "node scripts/check-identity.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "build:release": "node scripts/build-release.mjs",
    "build:release:mac": "node scripts/build-release-mac.mjs",
    "update:all": "node scripts/update-all.mjs",
    "build:update_all": "update_all.bat _inner && npm run build:release",
    "build:update_all:mac": "node scripts/update-all.mjs && npm run build:release:mac",
    "start": "npm run build && electron .",
    "stamp": "node scripts/sync-build-stamp.mjs"
  },
  "keywords": [
    "electron",
    "react",
    "frame",
    "boilerplate"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.33",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "node-forge": "^1.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.tinypdfeditor.neo",
    "productName": "Tiny PDF Editor - NEO",
    "icon": "build/icon.png",
    "directories": {
      "output": ".dist-build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "electron/**/*",
      "shared/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": ".engine-build/dist/tiny-pdf-engine",
        "to": "engine"
      },
      {
        "from": "electron/print",
        "to": "print"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir"
        }
      ]
    }
  }
}
