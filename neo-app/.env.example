# Optional. Copy to `.env` (project root in dev, beside the exe / in the data folder when installed).
# The 환경설정 → 서버 관리 values (data/settings.json) take precedence over these.

# Web server port (Electron window + LAN browsers share it)
APP_PORT=3021

# Bind address: 127.0.0.1 = this PC only (default), 0.0.0.0 = LAN / VPN
APP_HOST=127.0.0.1

# Override where settings / members / backups are stored
# APP_DATA_DIR=D:/frame-data
